# --- secrets -------------------------------------------------------------
# OpenCode Go API key. OPENCODE_API_KEY is accepted as a fallback.
OPENCODE_GO_API_KEY=
# Relay (Cloudflare Worker). RELAY_URL may be the base wss://host or the full wss://host/ingest.
RELAY_URL=wss://akhand-108.example.workers.dev/ingest
RELAY_TOKEN=

# --- run mode ------------------------------------------------------------
# opencode = real models, fake = offline built-in model (tests, demos)
PROVIDER=opencode
TZ=Asia/Kolkata
# First name of the person the prayers are for; shown on the live page.
SANKALPA_NAME=YourName
# Sankalpa line recited at the gathering, {name} is replaced. Devanagari.
# SANKALPA_TEXT=ॐ श्री गणेशाय नमः। {name} के कल्याण के लिए यह अखंड पाठ संकल्पित है।
GATHERING_TIME=06:00

# --- full sankalpa (OFF by default) -----------------------------------------------
# simple = the one fixed sentence above (default). full = sankalpa/template.txt rendered each gathering day with that
# day's panchang for the place below, recited line by line as verses. If anything needed is missing or wrong the
# harness logs why, shows it in `ctl status` (sankalpa.error) and stays on simple. Preview: python -m akhand.ctl sankalpa
# SANKALPA_MODE=full
# The yajamana's details, Devanagari, already inflected the way the template line needs them (nothing is inflected for you):
# SANKALPA_GOTRA_TEXT=कश्यपगोत्रोत्पन्नस्य
# SANKALPA_NAME_TEXT=देवदत्तशर्मणः
# SANKALPA_CITY_TEXT=काशीनगरे
# SANKALPA_STATE_TEXT=उत्तरप्रदेशे
# SANKALPA_PURPOSE_TEXT=आत्मकल्याणार्थं मोक्षप्राप्त्यर्थं च
# SANKALPA_ACT_TEXT=श्रीशिवदुर्गाप्रीत्यर्थं अखण्डजपपाठं
# Place for the panchang (decimal degrees, north and east positive). TZ above must be that place's timezone.
# PANCHANG_LAT=25.3176
# PANCHANG_LON=82.9739
# purnimanta (default, North India) or amanta
# PANCHANG_MASA_SYSTEM=purnimanta
# north (default: Vikram year + 10) or south (Shaka year + 12) 60-year samvatsara naming
# PANCHANG_SAMVATSARA=north
# drik (default: tropical solstices, 21 Dec / 21 Jun) or sidereal (Makara / Karka sankranti)
# PANCHANG_AYANA=drik
# Template file, one clause per line = one verse. Default: sankalpa/template.txt next to the akhand package.
# SANKALPA_TEMPLATE_PATH=

# --- providers (chat-completions path is appended to the base URL) ----------
# Free models, tried in this order; the paid backup comes after all of them.
FREE_MODELS=iceman-contributor-free,beam-free,longcat-2.5-free
# Per-model overrides, by short name (iceman, beam, longcat: model name without -free / -contributor / version)
# or by position counted from 1. Name wins over position. Fields: BASE_URL, API_KEY, REASONING_EFFORT
# ("none" = send no field), STREAM, TIMEOUT_S, VERSES_PER_CALL. Defaults: iceman effort low, beam/longcat no
# effort, longcat timeout 180 s, everything else REQUEST_TIMEOUT_S / VERSES_PER_CALL.
# FREE_BEAM_REASONING_EFFORT=low
# FREE_3_TIMEOUT_S=240
# Old names still work and configure the FIRST free model: PRIMARY_BASE_URL, PRIMARY_API_KEY, PRIMARY_STREAM,
# PRIMARY_REASONING_EFFORT, and PRIMARY_MODEL (replaces the first entry when FREE_MODELS is not set).
PRIMARY_BASE_URL=https://opencode.ai/zen/go/v1
PRIMARY_MODEL=iceman-contributor-free
PRIMARY_STREAM=true
PRIMARY_REASONING_EFFORT=low
BACKUP_BASE_URL=https://opencode.ai/zen/go/v1
BACKUP_MODEL=muse-spark-1.3-contributor
BACKUP_STREAM=true
BACKUP_REASONING_EFFORT=minimal
# PRIMARY_API_KEY= / BACKUP_API_KEY=   (default: OPENCODE_GO_API_KEY)
BACKUP_PRICE_IN_PER_M=0.10
BACKUP_PRICE_OUT_PER_M=0.20
# reserved against the budget before each backup call, then settled to usage.opencode.allowance
BACKUP_RESERVE_USD=0.0003
# spread backup spend evenly over the month/week instead of spending it as fast as agents ask
BACKUP_PACED=true

# --- pace and budget ---------------------------------------------------------
TARGET_VERSES_PER_AGENT_HOUR=360
MAX_CONCURRENCY=24
# verses per call for free models and the backup (override per model as above, backup: BACKUP_VERSES_PER_CALL)
VERSES_PER_CALL=24
RELAY_TURN_VERSES=8
JAPA_REPS=27
MUSE_MONTH_USD=30
MUSE_WEEK_USD=7
MAX_SILENCE_MIN=30

# --- resilience --------------------------------------------------------------
# a free model that failed on most of at least BREAKER_MIN_CALLS calls in the window is left
BREAKER_WINDOW_S=60
BREAKER_MIN_CALLS=20
PROBE_INTERVAL_S=300
AUTH_REST_S=900
REQUEST_TIMEOUT_S=120
# mode shows "resting" when nothing was verified for this long
RESTING_AFTER_S=180
GATHERING_MAX_MIN=30
# exit non-zero (Docker restarts the container) if praying, a provider looks healthy, and nothing verified for this long
WATCHDOG_MIN=15

# --- status hand-off (optional watcher, see hermes/) ---------------------------
# Host folder that docker compose mounts at /export (must be writable by uid 10001), e.g. ./export
# EXPORT_DIR=./export
STATUS_EXPORT_PATH=/export/status.json
STATUS_EXPORT_EVERY_S=30
CONTROL_PATH=/export/control.json
CONTROL_POLL_S=10

# --- fake provider only (PROVIDER=fake) -----------------------------------------
FAKE_ERROR_RATE=0
FAKE_WRONG_RATE=0
FAKE_LATENCY=0.3
# a fake free model answers 429 with a long Retry-After after N calls, e.g. iceman:60,beam:120
FAKE_QUOTA=
FAKE_QUOTA_RETRY_AFTER_S=3600
